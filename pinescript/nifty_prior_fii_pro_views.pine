if barstate.isfirst
    recs := array.concat(recs, str.split("B,B,-194818,-158213,477176,5236,145235,-36897,135390,8648,-486193;N,N,-186612,-176285,440725,3566,132067,-22921,133488,39874,-470209;N,X,-173113,-184525,453770,-18,155914,181150,127924,24116,-687620;U,B,-150816,-128530,433395,-11121,181963,75732,116282,-57674,-561032;D,D,-153773,-164997,485728,-18363,-18078,-34252,134297,177805,-500002;d,U,-158903,-228591,461172,-12240,147214,46669,136151,76116,-557620;B,B,-145118,-163045,387627,-13225,190664,-39833,123867,-33433,-398489;D,D,-150058,-213031,414412,-14661,240413,100174,130386,-34360,-566751;N,N,-152163,-199936,429792,-12782,213586,72417,130352,-20660,-552857;D,X,-156131,-197579,485144,-11128,1855,-13074,135674,188733,-523270;D,u,-165169,-230939,499737,-9775,75882,23430,144899,147788,-574142;d,U,-168702,-288841,474116,-10733,87180,-39305,149386,194372,-485562;N,d,-176698,-276645,497176,-9774,136817,59914,155682,132579,-607692;u,D,-181587,-228525,502455,-10043,125614,112002,160591,95601,-660766;X,X,-194158,-231661,611080,-10711,-71246,39113,173796,295638,-697400;D,U,-209807,-313586,571624,-3170,33355,97090,185408,272961,-712819;B,N,-212113,-233793,478916,11530,114315,167492,173305,111337,-690662;N,N,-209855,-218113,467947,10724,145158,185335,171016,64864,-697536;X,X,-219383,-199680,581958,13207,-35340,198480,181156,227012,-843989;U,B,-184227,-198430,549436,9249,99801,24124,157636,94693,-604022;d,X,-186060,-235885,555751,8188,40908,75274,160283,191071,-663004;U,B,-202633,-230020,594360,5461,134473,96217,176959,91197,-725066;u,X,-209315,-225462,551407,10808,25471,102855,178219,195682,-686046;X,d,-222032,-248061,632465,14425,-18758,92559,187130,261983,-756948;N,u,-229163,-299253,593223,15826,21925,88909,200070,273067,-712140;D,X,-235102,-312207,650049,15819,-74441,119733,205996,382537,-801821;U,B,-235838,-303454,580911,14627,73689,103240,209842,225870,-716258;D,X,-250093,-298102,631147,20130,-73068,227067,218910,367520,-889308;d,B,-261557,-302082,650645,24647,-44990,62142,225638,3